build/
*.whl

# Output artifacts (generated per run — not source code).
#
# This was a list of specific paths, and every one of them was already TRACKED
# before the pattern was added. .gitignore does not apply to tracked files, so
# output/.ai_cache.db was simultaneously ignored and committed, and the list
# grew a new line each time someone noticed another leak instead of fixing the
# cause.
#
# Ignore the whole directory. Audited 2026-09-29: 16 files, 3.9MB, in a PUBLIC
# repository — seven compiled resumes carrying a real phone number and email
# address, a dump of the user_resumes table including a user_id, the AI
# response cache, and scraped job data. None of it is source; all of it is
# reproducible by running the pipeline.
#
# Untracking does not unpublish what is already in history. That would need a
# history rewrite, which is a separate decision.
output/

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.nav
*.snm
*.fls
*.fdb_latexmk
*.synctex.gz
texput.*

# Environment and secrets
.env
# Backups and variants — a stale .env copy is still a live secret, and this
# repository is public. `.env` alone did not cover .env.bak-160145, which an
# editor left in the working tree on 2026-09-29.
.env.*
!.env.example
*.bak
*.bak-*
*.env
!.env.example
samconfig.toml

