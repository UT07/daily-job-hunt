# Vite env for the Playwright E2E dev server (`vite --mode e2e`).
#
# NOTHING HERE IS A SECRET, and that is deliberate.
#
# VITE_SUPABASE_URL deliberately points at a host that does not exist, so a
# test run can never reach the owner's real Supabase project. The frontend
# only ever talks to Supabase for interactive sign-in; the suite injects a
# session into localStorage instead (see e2e/fixtures/session.js), and every
# /api/** call carries that session's bearer token to the backend, which is
# where auth is actually enforced.
#
# The hostname's first label decides the localStorage key supabase-js reads:
#   `sb-${new URL(url).hostname.split('.')[0]}-auth-token`  ->  sb-e2e-auth-token
# Change the hostname here and e2e/fixtures/session.js follows automatically
# (it derives the key from this same value) -- but keep a first label that is
# a sane key.
VITE_SUPABASE_URL=https://e2e.supabase.invalid
VITE_SUPABASE_ANON_KEY=e2e-anon-key-not-a-real-key

# Empty => the app uses relative /api paths, which Vite proxies to
# http://localhost:8000 (see vite.config.js). In mocked mode Playwright
# intercepts them before they leave the browser; in live mode the proxy
# carries them to a locally-run uvicorn.
VITE_API_URL=

# Analytics off: a test run must not emit events into the real project.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Suppresses the deploy-preview banner (PreviewBanner.jsx renders only for
# "preview"/"branch"), which would otherwise sit above every page.
VITE_BUILD_LABEL=production
